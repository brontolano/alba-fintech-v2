# Database (MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/alba_finance_v3

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Auth initial admin (HANYA untuk seed lokal — ganti sebelum produksi!)
NEXTAUTH_EMAIL=admin@alba.local
NEXTAUTH_PASSWORD=ganti-ini-password-kuat-min-12-karakter

# Environment
NODE_ENV=development

# Folder penyimpanan bukti/image (bukti transaksi, foto profil, dll).
# Default dev: <project>/data/uploads. Di produksi default ke
# os.homedir()/alba-fintech-uploads (LUAR public_html agar tidak ter-wipe
# saat auto-deploy Git). Set UPLOAD_DIR untuk kustom lokasi.
UPLOAD_DIR=

# Optional off-site backup through Google Apps Script
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Bukti transaksi ke Google Drive via Apps Script yang sama
# (lihat scripts/google-drive-upload.gs untuk kode tempel).
# Folder root Drive pemilik; subfolder dibuat otomatis
# ("Bukti Transaksi", "Foto Profil").
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Application (Client-visible)
NEXT_PUBLIC_APP_NAME=ALBA Finance v3
NEXT_PUBLIC_APP_DESCRIPTION=Aplikasi Keuangan Pondok Pesantren Al-Basyariyah
NEXT_PUBLIC_COMPANY_NAME=Pondok Pesantren Al-Basyariyah
NEXT_PUBLIC_COMPANY_ADDRESS=Jl. Mahmud, Rahayu, Kec. Margaasih, Kab. Bandung, Jawa Barat 40218
NEXT_PUBLIC_CURRENCY=IDR
NEXT_PUBLIC_LOCALE=id-ID
