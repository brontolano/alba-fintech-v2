# =================================
# ALBA Finance v2 — Environment
# Copy to .env and fill values
# =================================

# ── Database ──────────────────────────────────────
# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE?schema=public
DATABASE_URL="mysql://user:password@localhost:3306/alba_finance?schema=public"

# ── NextAuth ──────────────────────────────────────
# Generate: npx auth secret (or: openssl rand -base64 32)
NEXTAUTH_URL="https://alba-finance.example.com"
NEXTAUTH_SECRET="base64-encoded-32-byte-random-secret-here"

# ── Google OAuth (optional) ───────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Application ───────────────────────────────────
# Default port: 3000
PORT=3000

# ── AI Provider ───────────────────────────────────
# AI API endpoint (include /v1 if needed)
AI_PROVIDER_URL="https://9router-dk0n.srv1167690.hstgr.cloud/v1"
# API key for the AI provider
AI_PROVIDER_KEY="Bearer-your-api-key-here"
# Optional: model name (default: Hamdan-MAX)
AI_PROVIDER_MODEL="Hamdan-MAX"

# ── Logging ───────────────────────────────────────
# Set to "debug" for verbose logs
NEXTAUTH_DEBUG=true

# ── Hostinger Deployment ──────────────────────────
# Hostinger uses hPanel → Env vars set there
# Do NOT commit .env file
