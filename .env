# Database (SQLite for local development)
DATABASE_URL=file:./dev.db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_string_32_chars

# Auth initial admin (replace before production)
NEXTAUTH_EMAIL=admin@alba.local
NEXTAUTH_PASSWORD=replace_with_secure_password

# Environment
NODE_ENV=development

# Folder penyimpanan bukti/image
UPLOAD_DIR=

# Optional off-site backup
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Application (Client-visible)
NEXT_PUBLIC_APP_NAME=ALBA Finance v3
NEXT_PUBLIC_APP_DESCRIPTION=Aplikasi Keuangan Pondok Pesantren Al-Basyariyah
NEXT_PUBLIC_COMPANY_NAME=Pondok Pesantren Al-Basyariyah
NEXT_PUBLIC_COMPANY_ADDRESS=Jl. Mahmud, Rahayu, Kec. Margaasih, Kab. Bandung, Jawa Barat 40218
NEXT_PUBLIC_CURRENCY=IDR
NEXT_PUBLIC_LOCALE=id-ID
