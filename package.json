{
  "name": "alba-fintech-v3",
  "version": "1.1.0",
  "description": "Aplikasi Keuangan Pondok Pesantren Al-Basyariyah v3",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.x",
  "overrides": {
    "postcss": "8.5.28"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "build:no-lint": "npm run prisma:generate && next build --no-lint",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prepare": "prisma generate",
    "deploy:prepare": "node scripts/deploy-prepare.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "reset:users": "tsx scripts/reset-users.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.3",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "uuid": "^14.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "postcss": "8.5.28",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^5.22.0",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "files": [
    ".next/standalone",
    ".next/static",
    "public",
    "prisma",
    "server.js"
  ]
}