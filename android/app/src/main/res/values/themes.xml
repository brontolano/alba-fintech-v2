<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material3 DayNight theme — auto switches between light and dark mode.
         Compose handles all color theming via AlbaFintechTheme; this XML
         only provides the Activity window background -->
    <style name="Theme.AlbaFintech" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/onTertiary</item>
    </style>

    <!-- Referenced by MainActivity -->
    <style name="Theme.AlbaFintech.NoActionBar" parent="Theme.AlbaFintech" />

</resources>
