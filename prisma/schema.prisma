generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lembaga {
  id                   String                   @id @default(cuid())
  name                 String                   @unique
  code                 String?                  @unique
  description          String?
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  units                Unit[]
  users                User[]
  pimpinanFinancialNotes PimpinanFinancialNote[]

  @@map("lembarga")
}

model Unit {
  id           String        @id @default(cuid())
  name          String   @unique
  code          String   @unique
  description   String?
  isActive      Boolean  @default(true)
  isRetail      Boolean  @default(false) @map("is_retail") // Enable POS & Inventory pages
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lembagaId     String?  @map("lembaga_id")
  lembaga      Lembaga?       @relation(fields: [lembagaId], references: [id])
  transactions Transaction[]
  users        User[]
  pimpinanFinancialNotes PimpinanFinancialNote[]

  @@index([lembagaId], map: "units_lembaga_id_fkey")
  @@map("units")
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String?
  passwordHash         String         @map("password_hash")
  role                 Role           @default(STAFF)
  unitId               String?        @map("unit_id")
  isActive             Boolean        @default(true)
  emailVerified        DateTime?      @map("email_verified")
  image                String?
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  approvals            Approval[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  pimpinanFinancialNotes PimpinanFinancialNote[]
  broadcastMessages    BroadcastMessage[]
  broadcastRecipients  BroadcastRecipient[]
  transactionsApproved Transaction[]  @relation("TransactionApprover")
  transactionsCreated  Transaction[]  @relation("TransactionCreator")
  unit                 Unit?          @relation(fields: [unitId], references: [id])
  lembagaId            String?        @map("lembaga_id")
  lembaga              Lembaga?       @relation(fields: [lembagaId], references: [id])

  @@index([unitId], map: "users_unit_id_fkey")
  @@index([lembagaId], map: "users_lembaga_id_fkey")
  @@map("users")
}

model Transaction {
  id           String            @id @default(cuid())
  unitId       String            @map("unit_id")
  type         TransactionType
  amount       Float
  description  String
  status       TransactionStatus @default(DRAFT)
  reference    String?
  photoUrl     String?           @map("photo_url")
  createdById  String            @map("created_by_id")
  approvedById String?           @map("approved_by_id")
  approvedAt   DateTime?         @map("approved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  accountId    String?           @map("account_id")
  approvals    Approval[]
  account      Account?          @relation(fields: [accountId], references: [id])
  approvedBy   User?             @relation("TransactionApprover", fields: [approvedById], references: [id])
  createdBy    User              @relation("TransactionCreator", fields: [createdById], references: [id])
  unit         Unit              @relation(fields: [unitId], references: [id])

  @@index([unitId])
  @@index([status])
  @@index([createdById])
  @@index([accountId], map: "transactions_account_id_fkey")
  @@index([approvedById], map: "transactions_approved_by_id_fkey")
  @@index([status, createdAt]) // For laporan per status + tanggal
  @@index([unitId, createdAt]) // For rekonsiliasi per unit + tanggal
  @@index([type, createdAt])   // For tren pemasukan/pengeluaran per tanggal
  @@map("transactions")
}

model Approval {
  id            String         @id @default(cuid())
  transactionId String         @map("transaction_id")
  approverId    String         @map("approver_id")
  status        ApprovalStatus @default(PENDING)
  comment       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  approver      User           @relation(fields: [approverId], references: [id])
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([approverId])
  @@map("approvals")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   String?  @map("old_data")
  newData   String?  @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Account {
  id           String        @id @default(cuid())
  name         String        @unique
  code         String        @unique
  type         AccountType
  description  String?
  parentId     String?       @map("parent_id")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  parent       Account?      @relation("AccountParent", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountParent")
  transactions Transaction[]

  @@index([type])
  @@index([parentId])
  @@map("accounts")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?          @map("user_id")
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@map("account_type")
}

enum Role {
  SUPERADMIN
  PIMPINAN
  MANAGER
  STAFF

  @@map("role")
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("transaction_status")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR

  @@map("notification_type")
}

// ========================================
// MODEL BARU: PimpinanFinancialNote
// Catatan keuangan sederhana dari rekonsiliasi Manager → Pimpinan
// ========================================
model PimpinanFinancialNote {
  id            String        @id @default(cuid())
  unitId        String?       @map("unit_id")
  lembagaId     String?       @map("lembaga_id")
  title         String
  description   String?
  amount        Float
  type          FinancialNoteType @default(PEMASUKAN)
  noteDate      DateTime      @map("note_date")
  reference     String?
  isSummary     Boolean       @default(false) @map("is_summary")
  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  unit          Unit?         @relation(fields: [unitId], references: [id])
  lembaga       Lembaga?      @relation(fields: [lembagaId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@index([unitId], map: "pfn_unit_id_idx")
  @@index([lembagaId], map: "pfn_lembaga_id_idx")
  @@index([noteDate], map: "pfn_note_date_idx")
  @@index([type, noteDate], map: "pfn_type_date_idx")
  @@index([isSummary], map: "pfn_is_summary_idx")
  @@index([createdById], map: "pfn_created_by_idx")
  @@map("pimpinan_financial_notes")
}

// ========================================
// MODEL BARU: BroadcastMessage + BroadcastRecipient
// Sistem broadcast/push notifikasi dari Pimpinan (dengan bantuan AI)
// ========================================
model BroadcastMessage {
  id                String              @id @default(cuid())
  title             String
  message           String
  type              NotificationType
  priority          BroadcastPriority   @default(NORMAL)
  isDraft           Boolean           @default(false) @map("is_draft")
  isSent            Boolean           @default(false) @map("is_sent")
  sentAt            DateTime?         @map("sent_at")
  deliveredTo       Int?              @map("delivered_to")
  senderId          String            @map("sender_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  sender            User              @relation(fields: [senderId], references: [id])
  broadcastRecipients BroadcastRecipient[]

  @@index([isSent], map: "bm_is_sent_idx")
  @@index([createdAt], map: "bm_created_at_idx")
  @@index([senderId], map: "bm_sender_id_idx")
  @@map("broadcast_messages")
}

model BroadcastRecipient {
  id            String        @id @default(cuid())
  broadcastId   String        @map("broadcast_id")
  userId        String        @map("user_id")
  isRead        Boolean       @default(false) @map("is_read")
  readAt        DateTime?     @map("read_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  broadcast     BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@unique([broadcastId, userId])
  @@index([userId])
  @@index([isRead])
  @@map("broadcast_recipients")
}

enum FinancialNoteType {
  PEMASUKAN
  PENGELUARAN
  REKONSILIASI

  @@map("financial_note_type")
}

enum BroadcastPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("broadcast_priority")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  endpoint   String   @unique @map("endpoint") @db.VarChar(512)
  keys       Json     @db.Json
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
