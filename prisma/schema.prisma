generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Unit {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  description String?
  isActive    Boolean?      @default(true)
  type        String        @default("KPAK")
  users       User[]        @relation(name: "UserUnit")
  santris     Santri[]      @relation(name: "SantriUnit")
  tagihan     Tagihan[]     @relation(name: "TagihanUnit")
  shifts      Shift[]       @relation(name: "UnitShift")
  rollings    Rolling[]     @relation(name: "UnitRolling")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  UnitPartner UnitPartner[] @relation(name: "UnitPartnerUnit")
  UnitSetting UnitSetting[] @relation(name: "UnitSettingUnit")
  approvals   Approval[]    @relation(name: "ApprovalUnit")
  notices     Notice[]      @relation(name: "NoticeUnit")
  retailUnits RetailUnit[]  @relation(name: "RetailUnitUnit")
  reports     Report[]      @relation(name: "ReportUnit")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String?
  passwordHash        String
  role                String
  unitId              String
  unit                Unit                @relation(name: "UserUnit", fields: [unitId], references: [id])
  shifts              Shift[]             @relation(name: "UserShift")
  absensis            Absensi[]           @relation(name: "UserAbsensi")
  rollings            Rolling[]           @relation(name: "UserRolling")
  approvalsRequested  Approval[]          @relation("ApprovalRequested")
  approvalsApproved   Approval[]          @relation("ApprovalApproved")
  noticesCreated      Notice[]            @relation(name: "NoticeCreated")
  reportsCreated      Report[]            @relation(name: "ReportCreated")
  noticeReads         NoticeRead[]        @relation("NoticeReadUser")
  auditLogs           AuditLog[]          @relation("AuditLogUser")
  notifications       Notification[]      @relation("UserNotification")
  retailTransactions  RetailTransaction[] @relation("UserRetailTransaction")
  adjustmentsApproved TagihanAdjustment[] @relation("AdjustmentApprovedBy")
  adjustmentsCreated  TagihanAdjustment[] @relation("AdjustmentCreatedBy")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Santri {
  id                 String              @id @default(cuid())
  studentNumber      String              @unique
  name               String
  className          String?
  cardUid            String?             @unique
  isActive           Boolean?            @default(true)
  unitId             String
  unit               Unit                @relation(name: "SantriUnit", fields: [unitId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  NFC                Nfc?                @relation(name: "NfcSantri")
  tagihan            Tagihan[]           @relation(name: "SantriTagihan")
  wali               String?
  kontak             String?
  tabungans          Tabungan[]          @relation("SantriTabungan")
  retailTransactions RetailTransaction[] @relation("SantriRetailTransaction")
}

model Nfc {
  id        String   @id @default(cuid())
  uid       String   @unique
  santri    Santri?  @relation(name: "NfcSantri", fields: [santriId], references: [id])
  santriId  String?  @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  NfcLog    NfcLog[] @relation(name: "NfcLogNfc")
}

model NfcLog {
  id        String   @id @default(cuid())
  nfcId     String
  nfc       Nfc      @relation(name: "NfcLogNfc", fields: [nfcId], references: [id])
  action    String
  timestamp DateTime @default(now())
}

model UnitPartner {
  id        String   @id @default(cuid())
  name      String
  unitId    String
  unit      Unit     @relation(name: "UnitPartnerUnit", fields: [unitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnitSetting {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(name: "UnitSettingUnit", fields: [unitId], references: [id])
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TagihanTemplate {
  id          String                @id @default(cuid())
  name        String
  description String?
  type        String?
  isActive    Boolean?              @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  items       TagihanTemplateItem[] @relation(name: "ItemTemplate")
  tagihan     Tagihan[]             @relation(name: "TemplateTagihan")
}

model TagihanTemplateItem {
  id         String          @id @default(cuid())
  template   TagihanTemplate @relation(name: "ItemTemplate", fields: [templateId], references: [id])
  templateId String
  kode       String?
  nama       String
  nominal    Float
  kategori   String?
  periode    String
  urutan     Int
  aktif      Boolean?        @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Tagihan {
  id          String              @id @default(cuid())
  unitId      String?
  unit        Unit?               @relation(name: "TagihanUnit", fields: [unitId], references: [id])
  santriId    String
  templateId  String
  tanggal     DateTime
  totalNilai  Float
  status      String              @default("UNPAID")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  santri      Santri              @relation(name: "SantriTagihan", fields: [santriId], references: [id])
  template    TagihanTemplate     @relation(name: "TemplateTagihan", fields: [templateId], references: [id])
  pembayaran  Pembayaran[]        @relation(name: "PembayaranTagihan")
  tagihanItem TagihanItem[]       @relation(name: "TagihanItemTagihan")
  adjustments TagihanAdjustment[] @relation("TagihanAdjustments")
}

model TagihanItem {
  id         String   @id @default(cuid())
  tagihan    Tagihan  @relation(name: "TagihanItemTagihan", fields: [tagihanId], references: [id])
  tagihanId  String
  templateId String?
  kode       String?
  nama       String
  nominal    Float
  kategori   String?
  periode    String
  urutan     Int
  aktif      Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Pembayaran {
  id         String   @id @default(cuid())
  tagihan    Tagihan  @relation(name: "PembayaranTagihan", fields: [tagihanId], references: [id])
  tagihanId  String
  santriId   String
  user_id    String?
  nominal    Float
  tanggal    DateTime
  buktiUrl   String?
  tipe       String?
  keterangan String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Shift {
  id         String    @id @default(cuid())
  unitId     String
  unit       Unit      @relation(name: "UnitShift", fields: [unitId], references: [id])
  petugasId  String
  petugas    User      @relation(name: "UserShift", fields: [petugasId], references: [id])
  absensis   Absensi[] @relation(name: "ShiftAbsensi")
  tanggal    DateTime
  jamMulai   DateTime?
  jamSelesai DateTime?
  jenis      String    @default("PAGI")
  status     String    @default("ACTIVE")
  keterangan String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Absensi {
  id         String    @id @default(cuid())
  shiftId    String
  shift      Shift     @relation(name: "ShiftAbsensi", fields: [shiftId], references: [id])
  petugasId  String
  petugas    User      @relation(name: "UserAbsensi", fields: [petugasId], references: [id])
  tanggal    DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("HADIR")
  keterangan String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Rolling {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(name: "UnitRolling", fields: [unitId], references: [id])
  petugasId  String
  petugas    User     @relation(name: "UserRolling", fields: [petugasId], references: [id])
  start_date DateTime
  end_date   DateTime
  shift_type String   @default("PAGI")
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Approval {
  id            String    @id @default(cuid())
  type          String // LAPORAN_HARIAN, PEMBAYARAN, TAGIHAN, SHIFT
  unitId        String
  unit          Unit      @relation(name: "ApprovalUnit", fields: [unitId], references: [id])
  requestedById String
  requestedBy   User      @relation("ApprovalRequested", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("ApprovalApproved", fields: [approvedById], references: [id])
  referenceId   String // ID of the entity being approved
  referenceType String // Tagihan, Pembayaran, Shift, LaporanHarian
  data          String // JSON string snapshot of data at request time
  keterangan    String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Notice {
  id          String       @id @default(cuid())
  unitId      String
  unit        Unit         @relation(name: "NoticeUnit", fields: [unitId], references: [id])
  title       String
  message     String
  targetRoles String       @default("STAFF") // Comma-separated: STAFF,KASI
  createdById String
  createdBy   User         @relation("NoticeCreated", fields: [createdById], references: [id])
  isRead      Boolean      @default(false)
  reads       NoticeRead[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model NoticeRead {
  id       String   @id @default(cuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id])
  userId   String
  user     User     @relation("NoticeReadUser", fields: [userId], references: [id])
  readAt   DateTime @default(now())

  @@unique([noticeId, userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // Tagihan, Pembayaran, Santri, User, Shift, etc.
  entityId   String
  action     String // CREATE, UPDATE, DELETE, APPROVE, REJECT
  userId     String
  user       User     @relation("AuditLogUser", fields: [userId], references: [id])
  oldData    String? // JSON string
  newData    String? // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(name: "ReportUnit", fields: [unitId], references: [id])
  type        String // LAPORAN_TABUNGAN, HER, DAFTAR_ULANG, DANA_KELUAR, LAPORAN_HARIAN
  data        String // JSON string snapshot
  notes       String?
  createdById String
  createdBy   User     @relation(name: "ReportCreated", fields: [createdById], references: [id])
  isDeleted   Boolean? @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TagihanAdjustment {
  id           String    @id @default(cuid())
  tagihanId    String
  tagihan      Tagihan   @relation("TagihanAdjustments", fields: [tagihanId], references: [id])
  santriId     String
  userId       String
  user         User      @relation("AdjustmentCreatedBy", fields: [userId], references: [id])
  tipe         String // DISKON, BIAYA_TAMBAHAN, PENANGGUNG_JAWAB
  nominal      Float
  keterangan   String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById String?
  approvedBy   User?     @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserNotification", fields: [userId], references: [id])
  type          String // LOW_BALANCE, PAYMENT_DUE, APPROVAL_REQUEST, INFO
  title         String
  message       String
  isRead        Boolean  @default(false)
  referenceId   String?
  referenceType String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Tabungan {
  id            String              @id @default(cuid())
  santriId      String
  santri        Santri              @relation(fields: [santriId], references: [id], name: "SantriTabungan")
  accountNumber String              @unique
  saldo         Float               @default(0)
  minSaldo      Float               @default(0)
  isDeleted     Boolean?            @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transaksis    TabunganTransaksi[] @relation("TabunganTransaksi")
}

model TabunganTransaksi {
  id          String   @id @default(cuid())
  tabunganId  String
  tabungan    Tabungan @relation("TabunganTransaksi", fields: [tabunganId], references: [id])
  santriId    String
  nominal     Float
  tipe        String // SETOR_TUNAI, SETOR_BANK, TARIK_TUNAI, MUTASI_MASUK, MUTASI_KELUAR, AUTO_DEDUCT_TAGIHAN
  kategori    String // TABUNGAN, HER, DAFTAR_ULANG, PSB, INTERNAL
  channel     String // CASH, BANK
  keterangan  String?
  buktiUrl    String?
  status      String   @default("LUNAS") // PENDING, LUNAS, GAGAL
  referenceId String? // tagihanId, targetTabunganId, etc
  userId      String? // petugas yang input
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RetailUnit {
  id           String              @id @default(cuid())
  name         String
  code         String              @unique
  type         String // KOPERASI, KANTIN
  description  String?
  isActive     Boolean?            @default(true)
  unitId       String
  unit         Unit                @relation(name: "RetailUnitUnit", fields: [unitId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  products     RetailProduct[]     @relation("RetailProductUnit")
  inventories  RetailInventory[]   @relation("RetailInventoryUnit")
  transactions RetailTransaction[] @relation("RetailTransactionUnit")
}

model RetailProduct {
  id               String                  @id @default(cuid())
  retailUnitId     String
  retailUnit       RetailUnit              @relation("RetailProductUnit", fields: [retailUnitId], references: [id])
  name             String
  code             String                  @unique
  description      String?
  price            Float
  stock            Int                     @default(0)
  minStock         Int                     @default(5)
  isActive         Boolean?                @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  inventories      RetailInventory[]       @relation("RetailInventoryProduct")
  transactionItems RetailTransactionItem[] @relation("RetailTransactionItemProduct")
}

model RetailInventory {
  id           String        @id @default(cuid())
  retailUnitId String
  retailUnit   RetailUnit    @relation("RetailInventoryUnit", fields: [retailUnitId], references: [id])
  productId    String
  product      RetailProduct @relation("RetailInventoryProduct", fields: [productId], references: [id])
  quantity     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([retailUnitId, productId])
}

model RetailTransaction {
  id            String                  @id @default(cuid())
  retailUnitId  String
  retailUnit    RetailUnit              @relation("RetailTransactionUnit", fields: [retailUnitId], references: [id])
  santriId      String?
  santri        Santri?                 @relation("SantriRetailTransaction", fields: [santriId], references: [id])
  userId        String?
  user          User?                   @relation("UserRetailTransaction", fields: [userId], references: [id])
  totalAmount   Float
  paymentMethod String // CASH, TABUNGAN, CARD
  status        String                  @default("COMPLETED") // PENDING, COMPLETED, CANCELLED, REFUNDED
  keterangan    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  items         RetailTransactionItem[] @relation("RetailTransactionItems")
}

model RetailTransactionItem {
  id            String            @id @default(cuid())
  transactionId String
  transaction   RetailTransaction @relation("RetailTransactionItems", fields: [transactionId], references: [id])
  productId     String
  product       RetailProduct     @relation("RetailTransactionItemProduct", fields: [productId], references: [id])
  quantity      Int
  unitPrice     Float
  subtotal      Float
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}
