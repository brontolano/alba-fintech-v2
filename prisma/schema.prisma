generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lembaga {
  id                  String              @id @default(cuid()) @db.VarChar(36)
  name                String              @unique(map: "name") @db.VarChar(255)
  code                String?             @unique(map: "code") @db.VarChar(255)
  description         String?             @db.Text
  address             String?             @db.Text
  isActive            Boolean?            @default(true)
  createdAt           DateTime?           @default(now()) @db.DateTime(0)
  updatedAt           DateTime?           @default(now()) @updatedAt @db.DateTime(0)
  broadcast_messages  BroadcastMessage[]
  financialCategories FinancialCategory[]
  units               Unit[]
  users               User[]

  @@map("lembagas")
}

model Unit {
  id              String          @id @default(cuid()) @db.VarChar(36)
  name            String          @db.VarChar(255)
  code            String          @unique(map: "code") @db.VarChar(255)
  description     String?         @db.Text
  isActive        Boolean?        @default(true)
  createdAt       DateTime?       @default(now()) @db.DateTime(0)
  updatedAt       DateTime?       @default(now()) @updatedAt @db.DateTime(0)
  lembagaId       String?         @db.VarChar(36)
  isRetail        Boolean?        @default(false)
  type            UnitType?       @default(KPAK)
  parentId        String?         @db.VarChar(36)
  approvals       Approval[]
  bankAccounts    BankAccount[]
  financial_notes FinancialNote[]
  inventory_items InventoryItem[]
  transactions    Transaction[]
  unit_settings   UnitSetting?
  lembaga         Lembaga?        @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "units_ibfk_1")
  users           User[]

  @@index([lembagaId], map: "lembagaId")
  @@map("units")
}

model User {
  id                                                    String               @id @default(cuid()) @db.VarChar(36)
  email                                                 String               @unique(map: "email") @db.VarChar(255)
  name                                                  String?              @db.VarChar(255)
  passwordHash                                          String               @db.VarChar(255)
  role                                                  Role?                @default(STAFF)
  unitId                                                String?              @db.VarChar(36)
  lembagaId                                             String?              @db.VarChar(36)
  isActive                                              Boolean?             @default(true)
  emailVerified                                         DateTime?            @db.DateTime(0)
  image                                                 String?              @db.VarChar(255)
  createdAt                                             DateTime?            @default(now()) @db.DateTime(0)
  updatedAt                                             DateTime?            @default(now()) @db.DateTime(0)
  approvals                                             Approval[]
  broadcast_messages                                    BroadcastMessage[]
  broadcast_recipients                                  BroadcastRecipient[]
  financial_notes_financial_notes_createdByIdTousers    FinancialNote[]      @relation("financial_notes_createdByIdTousers")
  financial_notes_financial_notes_approvedByIdTousers   FinancialNote[]      @relation("financial_notes_approvedByIdTousers")
  financial_notes_financial_notes_reconciledByIdTousers FinancialNote[]      @relation("financial_notes_reconciledByIdTousers")
  notifications                                         Notification[]
  transactions_transactions_createdByIdTousers          Transaction[]        @relation("transactions_createdByIdTousers")
  transactions_transactions_approvedByIdTousers         Transaction[]        @relation("transactions_approvedByIdTousers")
  units                                                 Unit?                @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "users_ibfk_1")
  lembagas                                              Lembaga?             @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "users_ibfk_2")

  @@index([lembagaId], map: "lembagaId")
  @@index([unitId], map: "unitId")
  @@map("users")
}

model FinancialCategory {
  id                         String              @id @default(cuid()) @db.VarChar(36)
  name                       String              @db.VarChar(255)
  code                       String              @unique(map: "code") @db.VarChar(255)
  type                       CategoryType
  description                String?             @db.Text
  parentId                   String?             @db.VarChar(36)
  isActive                   Boolean?            @default(true)
  createdAt                  DateTime?           @default(now()) @db.DateTime(0)
  updatedAt                  DateTime?           @default(now()) @updatedAt @db.DateTime(0)
  lembagaId                  String?             @db.VarChar(36)
  financial_categories       FinancialCategory?  @relation("financial_categoriesTofinancial_categories", fields: [parentId], references: [id], onUpdate: Restrict, map: "financial_categories_ibfk_1")
  other_financial_categories FinancialCategory[] @relation("financial_categoriesTofinancial_categories")
  lembaga                    Lembaga?            @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "financial_categories_ibfk_2")
  financial_notes            FinancialNote[]
  transactions               Transaction[]

  @@index([lembagaId], map: "lembagaId")
  @@index([parentId], map: "parentId")
  @@map("financial_categories")
}

model BankAccount {
  id           String        @id @default(cuid()) @db.VarChar(36)
  name         String        @db.VarChar(255)
  code         String        @unique(map: "code") @db.VarChar(255)
  type         AccountType
  balance      Decimal?      @default(0.00) @db.Decimal(15, 2)
  description  String?       @db.Text
  isActive     Boolean?      @default(true)
  createdAt    DateTime?     @default(now()) @db.DateTime(0)
  updatedAt    DateTime?     @default(now()) @updatedAt @db.DateTime(0)
  unitId       String?       @db.VarChar(36)
  unit         Unit?         @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "bank_accounts_ibfk_1")
  transactions Transaction[]

  @@index([unitId], map: "unitId")
  @@map("bank_accounts")
}

model Transaction {
  id                                     String             @id @default(cuid()) @db.VarChar(36)
  unitId                                 String             @db.VarChar(36)
  type                                   TransactionType
  amount                                 Decimal            @db.Decimal(15, 2)
  description                            String             @db.Text
  categoryId                             String?            @db.VarChar(36)
  accountId                              String?            @db.VarChar(36)
  reference                              String?            @db.VarChar(255)
  date                                   DateTime           @default(now()) @map("date") @db.DateTime(0)
  status                                 TransactionStatus? @default(PENDING)
  createdById                            String             @db.VarChar(36)
  approvedById                           String?            @db.VarChar(36)
  approvedAt                             DateTime?          @db.DateTime(0)
  photoUrl                               String?            @db.VarChar(500)
  paymentMethod                          String?            @db.VarChar(50)
  isPimpinanNote                         Boolean?           @default(false)
  createdAt                              DateTime?          @default(now()) @db.DateTime(0)
  updatedAt                              DateTime?          @default(now()) @db.DateTime(0)
  approvals                              Approval[]
  order_items                            OrderItem[]
  units                                  Unit               @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "transactions_ibfk_1")
  financial_categories                   FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_ibfk_2")
  bank_accounts                          BankAccount?       @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_ibfk_3")
  users_transactions_createdByIdTousers  User               @relation("transactions_createdByIdTousers", fields: [createdById], references: [id], onUpdate: Restrict, map: "transactions_ibfk_4")
  users_transactions_approvedByIdTousers User?              @relation("transactions_approvedByIdTousers", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_ibfk_5")

  @@index([accountId], map: "idx_transactions_account_id")
  @@index([approvedById], map: "idx_transactions_approved_by_id")
  @@index([categoryId], map: "idx_transactions_category_id")
  @@index([createdById], map: "idx_transactions_created_by_id")
  @@index([status], map: "idx_transactions_status")
  @@index([status, createdAt], map: "idx_transactions_status_created_at")
  @@index([unitId, createdAt], map: "idx_transactions_unit_created_at")
  @@index([unitId], map: "idx_transactions_unit_id")
  @@map("transactions")
}

model Approval {
  id            String          @id @default(cuid()) @db.VarChar(36)
  transactionId String          @db.VarChar(36)
  unitId        String?         @db.VarChar(36)
  approverId    String          @db.VarChar(36)
  status        ApprovalStatus? @default(PENDING)
  comment       String?         @db.Text
  createdAt     DateTime?       @default(now()) @db.DateTime(0)
  updatedAt     DateTime?       @default(now()) @db.DateTime(0)
  transactions  Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "approvals_ibfk_1")
  units         Unit?           @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "approvals_ibfk_2")
  users         User            @relation(fields: [approverId], references: [id], onUpdate: Restrict, map: "approvals_ibfk_3")

  @@index([approverId], map: "idx_approvals_approver_id")
  @@index([transactionId], map: "idx_approvals_transaction_id")
  @@index([unitId], map: "idx_approvals_unit_id")
  @@map("approvals")
}

model FinancialNote {
  id                                          String             @id @default(cuid()) @db.VarChar(36)
  unitId                                      String?            @db.VarChar(36)
  title                                       String             @db.VarChar(255)
  description                                 String             @db.Text
  amount                                      Decimal            @db.Decimal(15, 2)
  type                                        TransactionType
  date                                        DateTime?          @default(now()) @map("date") @db.DateTime(0)
  categoryId                                  String?            @db.VarChar(36)
  createdById                                 String             @db.VarChar(36)
  approvedById                                String?            @db.VarChar(36)
  approvedAt                                  DateTime?          @db.DateTime(0)
  createdAt                                   DateTime?          @default(now()) @db.DateTime(0)
  updatedAt                                   DateTime?          @default(now()) @db.DateTime(0)
  isReconciled                                Boolean?           @default(false)
  reconciledAt                                DateTime?          @db.DateTime(0)
  reconciledById                              String?            @db.VarChar(36)
  units                                       Unit?              @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "financial_notes_ibfk_1")
  financial_categories                        FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "financial_notes_ibfk_2")
  users_financial_notes_createdByIdTousers    User               @relation("financial_notes_createdByIdTousers", fields: [createdById], references: [id], onUpdate: Restrict, map: "financial_notes_ibfk_3")
  users_financial_notes_approvedByIdTousers   User?              @relation("financial_notes_approvedByIdTousers", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "financial_notes_ibfk_4")
  users_financial_notes_reconciledByIdTousers User?              @relation("financial_notes_reconciledByIdTousers", fields: [reconciledById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "financial_notes_ibfk_5")

  @@index([approvedById], map: "approvedById")
  @@index([categoryId], map: "categoryId")
  @@index([createdById], map: "idx_financial_notes_created_by_id")
  @@index([date], map: "idx_financial_notes_date")
  @@index([isReconciled], map: "idx_financial_notes_is_reconciled")
  @@index([unitId, date], map: "idx_financial_notes_unit_date")
  @@index([unitId], map: "idx_financial_notes_unit_id")
  @@index([reconciledById], map: "reconciledById")
  @@map("financial_notes")
}

model InventoryItem {
  id            String      @id @default(cuid()) @db.VarChar(36)
  unitId        String      @db.VarChar(36)
  name          String      @db.VarChar(200)
  sku           String      @unique(map: "sku") @db.VarChar(50)
  category      String?     @db.VarChar(100)
  imageUrl      String?     @db.VarChar(500)
  currentStock  Int?        @default(0)
  minStock      Int?        @default(0)
  unitPrice     Decimal?    @db.Decimal(12, 2)
  purchasePrice Decimal?    @db.Decimal(12, 2)
  isActive      Boolean?    @default(true)
  createdAt     DateTime?   @default(now()) @db.DateTime(0)
  updatedAt     DateTime?   @default(now()) @db.DateTime(0)
  units         Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inventory_items_ibfk_1")
  order_items   OrderItem[]

  @@index([category], map: "idx_inventory_items_category")
  @@index([unitId], map: "idx_inventory_items_unit_id")
  @@map("inventory_items")
}

model OrderItem {
  id              String         @id @default(cuid()) @db.VarChar(36)
  transactionId   String         @db.VarChar(36)
  itemId          String?        @db.VarChar(36)
  itemName        String         @db.VarChar(255)
  quantity        Int?           @default(1)
  unitPrice       Decimal        @db.Decimal(12, 2)
  totalPrice      Decimal        @db.Decimal(12, 2)
  transactions    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_items_ibfk_1")
  inventory_items InventoryItem? @relation(fields: [itemId], references: [id], onUpdate: Restrict, map: "order_items_ibfk_2")

  @@index([itemId], map: "idx_order_items_item_id")
  @@index([transactionId], map: "idx_order_items_transaction_id")
  @@map("order_items")
}

model Notification {
  id        String           @id @default(cuid()) @db.VarChar(36)
  userId    String?          @db.VarChar(36)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean?         @default(false)
  createdAt DateTime?        @default(now()) @db.DateTime(0)
  updatedAt DateTime?        @default(now()) @db.DateTime(0)
  users     User?            @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "notifications_ibfk_1")

  @@index([createdAt], map: "idx_notifications_created_at")
  @@index([isRead], map: "idx_notifications_is_read")
  @@index([userId], map: "idx_notifications_user_id")
  @@map("notifications")
}

model BroadcastMessage {
  id                   String               @id @default(cuid()) @db.VarChar(36)
  title                String               @db.VarChar(200)
  message              String               @db.Text
  type                 String?              @default("INFO") @db.VarChar(20)
  priority             String?              @default("NORMAL") @db.VarChar(20)
  status               BroadcastStatus?     @default(DRAFT)
  isDraft              Boolean?             @default(true)
  isSent               Boolean?             @default(false)
  sentAt               DateTime?            @db.DateTime(0)
  deliveredTo          Int?
  lembagaId            String?              @db.VarChar(36)
  senderId             String               @db.VarChar(36)
  createdAt            DateTime?            @default(now()) @db.DateTime(0)
  updatedAt            DateTime?            @default(now()) @db.DateTime(0)
  lembagas             Lembaga?             @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "broadcast_messages_ibfk_1")
  users                User                 @relation(fields: [senderId], references: [id], onUpdate: Restrict, map: "broadcast_messages_ibfk_2")
  broadcast_recipients BroadcastRecipient[]

  @@index([lembagaId], map: "idx_broadcast_messages_lembaga_id")
  @@index([senderId], map: "idx_broadcast_messages_sender_id")
  @@map("broadcast_messages")
}

model BroadcastRecipient {
  id                 String           @id @default(cuid()) @db.VarChar(36)
  broadcastId        String           @db.VarChar(36)
  userId             String           @db.VarChar(36)
  isRead             Boolean?         @default(false)
  createdAt          DateTime?        @default(now()) @db.DateTime(0)
  broadcast_messages BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "broadcast_recipients_ibfk_1")
  users              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "broadcast_recipients_ibfk_2")

  @@unique([broadcastId, userId], map: "idx_broadcast_recipients_unique")
  @@index([broadcastId], map: "idx_broadcast_recipients_broadcast_id")
  @@index([userId], map: "idx_broadcast_recipients_user_id")
  @@map("broadcast_recipients")
}

model UnitSetting {
  id               String    @id @default(cuid()) @db.VarChar(36)
  unitId           String    @unique(map: "unitId") @db.VarChar(36)
  posEnabled       Boolean?  @default(true)
  inventoryEnabled Boolean?  @default(true)
  autoApproval     Boolean?  @default(false)
  requiresApproval Boolean?  @default(true)
  createdAt        DateTime? @default(now()) @db.DateTime(0)
  updatedAt        DateTime? @default(now()) @db.DateTime(0)
  units            Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "unit_settings_ibfk_1")

  @@map("unit_settings")
}

// System Settings
model SystemSetting {
  id          String   @id @default(cuid()) @db.VarChar(36)
  key         String   @unique @db.VarChar(255)
  value       String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.DateTime(0)
  updatedAt   DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@map("system_settings")
}

enum Role {
  SUPERADMIN
  PIMPINAN
  MANAGER
  STAFF

  @@map("role")
}

enum UnitType {
  KPAK
  KOPERASI
  KANTIN
  UMUM

  @@map("unit_type")
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER

  @@map("category_type")
}

enum AccountType {
  CASH
  BANK
  E_WALLET

  @@map("account_type")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER

  @@map("transaction_type")
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("transaction_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR

  @@map("notification_type")
}

enum BroadcastStatus {
  DRAFT
  PENDING
  SENT
  FAILED

  @@map("broadcast_status")
}
