generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Lembaga {
  id                  String              @id @default(cuid()) @db.VarChar(36)
  name                String              @unique(map: "name") @db.VarChar(255)
  code                String?             @unique(map: "code") @db.VarChar(255)
  description         String?             @db.Text
  address             String?             @db.Text
  isActive            Boolean?            @default(true)
  createdAt           DateTime?           @default(now()) @db.DateTime(0)
  updatedAt           DateTime?           @default(now()) @updatedAt @db.DateTime(0)
  broadcast_messages  BroadcastMessage[]
  financialCategories FinancialCategory[]
  units               Unit[]
  users               User[]

  @@map("lembagas")
}

model Unit {
  id                  String              @id @default(cuid()) @db.VarChar(36)
  name                String              @db.VarChar(255)
  code                String              @unique(map: "code") @db.VarChar(255)
  description         String?             @db.Text
  isActive            Boolean?            @default(true)
  createdAt           DateTime?           @default(now()) @db.DateTime(0)
  updatedAt           DateTime?           @default(now()) @updatedAt @db.DateTime(0)
  lembagaId           String?             @db.VarChar(36)
  isRetail            Boolean?            @default(false)
  type                UnitType?           @default(KPAK)
  parentId            String?             @db.VarChar(36)
  approvals           Approval[]
  bankAccounts        BankAccount[]
  financial_notes     FinancialNote[]
  financialCategories FinancialCategory[]
  cash_handovers      CashHandover[]
  inventory_items     InventoryItem[]
  transactions        Transaction[]
  shift_attendances   ShiftAttendance[]
  shift_sessions      ShiftSession[]
  pos_sessions        PosSession[]
  shift_reports       ShiftReport[]
  budget_allocations  BudgetAllocation[]
  consignment_owners  ConsignmentOwner[]
  consignment_items   ConsignmentItem[]
  consignment_payouts ConsignmentPayout[]
  purchase_items      PurchaseItem[]
  stock_batches       StockBatch[]
  lembaga             Lembaga?            @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "units_ibfk_1")
  users               User[]

  @@index([lembagaId], map: "lembagaId")
  @@map("units")
}

model User {
  id                                                    String               @id @default(cuid()) @db.VarChar(36)
  email                                                 String               @unique(map: "email") @db.VarChar(255)
  name                                                  String?              @db.VarChar(255)
  passwordHash                                          String               @db.VarChar(255)
  role                                                  Role?                @default(STAFF)
  unitId                                                String?              @db.VarChar(36)
  lembagaId                                             String?              @db.VarChar(36)
  isActive                                              Boolean?             @default(true)
  emailVerified                                         DateTime?            @db.DateTime(0)
  image                                                 String?              @db.VarChar(255)
  createdAt                                             DateTime?            @default(now()) @db.DateTime(0)
  updatedAt                                             DateTime?            @default(now()) @db.DateTime(0)
  approvals                                             Approval[]
  audit_logs                                            audit_logs[]
  broadcast_messages                                    BroadcastMessage[]
  broadcast_recipients                                  BroadcastRecipient[]
  financial_notes_financial_notes_createdByIdTousers    FinancialNote[]      @relation("financial_notes_createdByIdTousers")
  financial_notes_financial_notes_approvedByIdTousers   FinancialNote[]      @relation("financial_notes_approvedByIdTousers")
  financial_notes_financial_notes_reconciledByIdTousers FinancialNote[]      @relation("financial_notes_reconciledByIdTousers")
  notifications                                         Notification[]
  push_subscriptions                                    push_subscriptions[]
  transactions_transactions_createdByIdTousers          Transaction[]        @relation("transactions_createdByIdTousers")
  transactions_transactions_approvedByIdTousers         Transaction[]        @relation("transactions_approvedByIdTousers")
  handoverSubmitted                                     CashHandover[]       @relation("handoverSubmitted")
  handoverAccepted                                      CashHandover[]       @relation("handoverAccepted")
  shiftAttendanceUser                                   ShiftAttendance[]    @relation("shiftAttendanceUser")
  shiftSessionUser                                      ShiftSession[]       @relation("shiftSessionUser")
  batchReviewer                                         StockBatch[]         @relation("batchReviewer")
  batchCreator                                          StockBatch[]         @relation("batchCreator")
  posSessionUser                                        PosSession[]         @relation("posSessionUser")
  shiftReportStaff                                      ShiftReport[]        @relation("shiftReportStaff")
  shiftReportReviewer                                   ShiftReport[]        @relation("shiftReportReviewer")
  allocationCreator                                     BudgetAllocation[]   @relation("allocationCreator")
  consignmentPayoutsPaid                                ConsignmentPayout[]  @relation("consignmentPayoutPaidBy")
  units                                                 Unit?                @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "users_ibfk_1")
  lembagas                                              Lembaga?             @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "users_ibfk_2")

  @@index([lembagaId], map: "lembagaId")
  @@index([unitId], map: "unitId")
  @@map("users")
}

model Student {
  id            String          @id @default(cuid()) @db.VarChar(36)
  studentNumber String          @unique(map: "studentNumber") @db.VarChar(50)
  name          String          @db.VarChar(255)
  className     String?         @db.VarChar(100)
  cardUid       String?         @unique(map: "cardUid") @db.VarChar(100)
  isActive      Boolean?        @default(true)
  lembagaId     String?         @db.VarChar(36)
  unitId        String?         @db.VarChar(36)
  createdAt     DateTime?       @default(now()) @db.DateTime(0)
  updatedAt     DateTime?       @default(now()) @updatedAt @db.DateTime(0)
  account       SavingsAccount?

  @@index([lembagaId], map: "students_lembagaId_idx")
  @@index([unitId], map: "students_unitId_idx")
  @@map("students")
}

model SavingsAccount {
  id               String               @id @default(cuid()) @db.VarChar(36)
  studentId        String               @unique(map: "studentId") @db.VarChar(36)
  unitId           String               @db.VarChar(36)
  balance          Decimal              @default(0.00) @db.Decimal(15, 2)
  status           SavingsAccountStatus @default(ACTIVE)
  dailySpendLimit  Decimal?             @db.Decimal(15, 2)
  createdAt        DateTime?            @default(now()) @db.DateTime(0)
  updatedAt        DateTime?            @default(now()) @updatedAt @db.DateTime(0)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "savings_accounts_ibfk_1")
  transactions SavingsTransaction[]

  @@index([unitId], map: "savings_accounts_unitId_idx")
  @@map("savings_accounts")
}

model SavingsTransaction {
  id            String              @id @default(cuid()) @db.VarChar(36)
  accountId     String              @db.VarChar(36)
  unitId        String              @db.VarChar(36)
  type          SavingsMutationType
  amount        Decimal             @db.Decimal(15, 2)
  balanceBefore Decimal             @db.Decimal(15, 2)
  balanceAfter  Decimal             @db.Decimal(15, 2)
  reference     String?             @db.VarChar(255)
  description   String?             @db.Text
  cardUid       String?             @db.VarChar(100)
  photoUrl      String?             @db.VarChar(500)
  channel       String?             @db.VarChar(20)
  createdById   String              @db.VarChar(36)
  createdAt     DateTime?           @default(now()) @db.DateTime(0)
  account       SavingsAccount      @relation(fields: [accountId], references: [id], onUpdate: Restrict, map: "savings_transactions_ibfk_1")

  @@index([accountId, createdAt], map: "savings_transactions_account_date_idx")
  @@index([unitId, createdAt], map: "savings_transactions_unit_date_idx")
  @@index([createdById], map: "savings_transactions_createdById_idx")
  @@map("savings_transactions")
}

model FinancialCategory {
  id                         String              @id @default(cuid()) @db.VarChar(36)
  name                       String              @db.VarChar(255)
  code                       String              @unique(map: "code") @db.VarChar(255)
  type                       CategoryType
  description                String?             @db.Text
  parentId                   String?             @db.VarChar(36)
  isActive                   Boolean?            @default(true)
  createdAt                  DateTime?           @default(now()) @db.DateTime(0)
  updatedAt                  DateTime?           @default(now()) @updatedAt @db.DateTime(0)
  lembagaId                  String?             @db.VarChar(36)
  unitId                     String?             @db.VarChar(36)
  financial_categories       FinancialCategory?  @relation("financial_categoriesTofinancial_categories", fields: [parentId], references: [id], onUpdate: Restrict, map: "financial_categories_ibfk_1")
  other_financial_categories FinancialCategory[] @relation("financial_categoriesTofinancial_categories")
  lembaga                    Lembaga?            @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "financial_categories_ibfk_2")
  unit                       Unit?               @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "financial_categories_ibfk_3")
  financial_notes            FinancialNote[]
  transactions               Transaction[]
  budget_allocations         BudgetAllocation[]

  @@index([lembagaId], map: "lembagaId")
  @@index([unitId], map: "unitId")
  @@index([parentId], map: "parentId")
  @@map("financial_categories")
}

model BankAccount {
  id           String        @id @default(cuid()) @db.VarChar(36)
  name         String        @db.VarChar(255)
  code         String        @unique(map: "code") @db.VarChar(255)
  type         AccountType
  balance      Decimal?      @default(0.00) @db.Decimal(15, 2)
  description  String?       @db.Text
  isActive     Boolean?      @default(true)
  createdAt    DateTime?     @default(now()) @db.DateTime(0)
  updatedAt    DateTime?     @default(now()) @updatedAt @db.DateTime(0)
  unitId       String?       @db.VarChar(36)
  unit         Unit?         @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "bank_accounts_ibfk_1")
  transactions Transaction[]

  @@index([unitId], map: "unitId")
  @@map("bank_accounts")
}

model Transaction {
  id                                     String              @id @default(cuid()) @db.VarChar(36)
  unitId                                 String              @db.VarChar(36)
  type                                   TransactionType
  amount                                 Decimal             @db.Decimal(15, 2)
  description                            String              @db.Text
  categoryId                             String?             @db.VarChar(36)
  accountId                              String?             @db.VarChar(36)
  posSessionId                           String?             @db.VarChar(36)
  reference                              String?             @db.VarChar(255)
  date                                   DateTime?           @default(now()) @map("date") @db.DateTime(0)
  status                                 TransactionStatus?  @default(PENDING)
  createdById                            String              @db.VarChar(36)
  approvedById                           String?             @db.VarChar(36)
  approvedAt                             DateTime?           @db.DateTime(0)
  isReconciled                           Boolean?            @default(false)
  reconciledAt                           DateTime?           @db.DateTime(0)
  photoUrl                               String?             @db.VarChar(500)
  paymentMethod                          String?             @db.VarChar(50)
  isPimpinanNote                         Boolean?            @default(false)
  createdAt                              DateTime?           @default(now()) @db.DateTime(0)
  updatedAt                              DateTime?           @default(now()) @db.DateTime(0)
  approvals                              Approval[]
  order_items                            OrderItem[]
  consignment_payouts                    ConsignmentPayout[]
  purchase_items                         PurchaseItem[]
  units                                  Unit                @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "transactions_ibfk_1")
  financial_categories                   FinancialCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_ibfk_2")
  bank_accounts                          BankAccount?        @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_ibfk_3")
  pos_sessions                           PosSession?         @relation(fields: [posSessionId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "transactions_possession_ibfk")
  users_transactions_createdByIdTousers  User                @relation("transactions_createdByIdTousers", fields: [createdById], references: [id], onUpdate: Restrict, map: "transactions_ibfk_4")
  users_transactions_approvedByIdTousers User?               @relation("transactions_approvedByIdTousers", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_ibfk_5")

  @@index([accountId], map: "accountId")
  @@index([approvedById], map: "approvedById")
  @@index([categoryId], map: "categoryId")
  @@index([createdById], map: "createdById")
  @@index([unitId], map: "unitId")
  @@map("transactions")
}

model Approval {
  id            String          @id @default(cuid()) @db.VarChar(36)
  transactionId String          @db.VarChar(36)
  unitId        String?         @db.VarChar(36)
  approverId    String          @db.VarChar(36)
  status        ApprovalStatus? @default(PENDING)
  comment       String?         @db.Text
  createdAt     DateTime?       @default(now()) @db.DateTime(0)
  updatedAt     DateTime?       @default(now()) @db.DateTime(0)
  transactions  Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "approvals_ibfk_1")
  units         Unit?           @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "approvals_ibfk_2")
  users         User            @relation(fields: [approverId], references: [id], onUpdate: Restrict, map: "approvals_ibfk_3")

  @@index([approverId], map: "approverId")
  @@index([transactionId], map: "transactionId")
  @@index([unitId], map: "unitId")
  @@map("approvals")
}

model FinancialNote {
  id                                          String             @id @default(cuid()) @db.VarChar(36)
  unitId                                      String?            @db.VarChar(36)
  title                                       String             @db.VarChar(255)
  description                                 String             @db.Text
  amount                                      Decimal            @db.Decimal(15, 2)
  type                                        TransactionType
  date                                        DateTime?          @default(now()) @map("date") @db.DateTime(0)
  categoryId                                  String?            @db.VarChar(36)
  createdById                                 String             @db.VarChar(36)
  approvedById                                String?            @db.VarChar(36)
  approvedAt                                  DateTime?          @db.DateTime(0)
  createdAt                                   DateTime?          @default(now()) @db.DateTime(0)
  updatedAt                                   DateTime?          @default(now()) @db.DateTime(0)
  isReconciled                                Boolean?           @default(false)
  reconciledAt                                DateTime?          @db.DateTime(0)
  reconciledById                              String?            @db.VarChar(36)
  units                                       Unit?              @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "financial_notes_ibfk_1")
  financial_categories                        FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "financial_notes_ibfk_2")
  users_financial_notes_createdByIdTousers    User               @relation("financial_notes_createdByIdTousers", fields: [createdById], references: [id], onUpdate: Restrict, map: "financial_notes_ibfk_3")
  users_financial_notes_approvedByIdTousers   User?              @relation("financial_notes_approvedByIdTousers", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "financial_notes_ibfk_4")
  users_financial_notes_reconciledByIdTousers User?              @relation("financial_notes_reconciledByIdTousers", fields: [reconciledById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "financial_notes_ibfk_5")

  @@index([approvedById], map: "approvedById")
  @@index([categoryId], map: "categoryId")
  @@index([reconciledById], map: "reconciledById")
  @@index([createdById], map: "createdById")
  @@index([unitId], map: "unitId")
  @@map("financial_notes")
}

model CashHandover {
  id            String         @id @default(cuid()) @db.VarChar(36)
  unitId        String         @db.VarChar(36)
  date          DateTime       @db.DateTime(0)
  totalIncome   Decimal        @db.Decimal(15, 2)
  totalExpense  Decimal        @db.Decimal(15, 2)
  systemBalance Decimal        @db.Decimal(15, 2)
  cashHanded    Decimal        @db.Decimal(15, 2)
  variance      Decimal        @db.Decimal(15, 2)
  status        HandoverStatus @default(PENDING)
  submittedById String         @db.VarChar(36)
  submittedAt   DateTime       @default(now()) @db.DateTime(0)
  acceptedById  String?        @db.VarChar(36)
  acceptedAt    DateTime?      @db.DateTime(0)
  note          String?        @db.Text
  units         Unit           @relation(fields: [unitId], references: [id], onUpdate: Restrict)
  submittedBy   User           @relation("handoverSubmitted", fields: [submittedById], references: [id], onUpdate: Restrict)
  acceptedBy    User?          @relation("handoverAccepted", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([unitId, date], map: "cash_handovers_unit_date_key")
  @@index([unitId], map: "cash_handovers_unitId")
  @@index([submittedById], map: "cash_handovers_submittedById")
  @@index([status], map: "cash_handovers_status")
  @@map("cash_handovers")
}

model InventoryItem {
  id               String           @id @default(cuid()) @db.VarChar(36)
  unitId           String           @db.VarChar(36)
  name             String           @db.VarChar(200)
  sku              String           @unique(map: "sku") @db.VarChar(50)
  category         String?          @db.VarChar(100)
  imageUrl         String?          @db.VarChar(500)
  currentStock     Int?             @default(0)
  minStock         Int?             @default(0)
  unitPrice        Decimal?         @db.Decimal(12, 2)
  purchasePrice    Decimal?         @db.Decimal(12, 2)
  isActive         Boolean?         @default(true)
  createdAt        DateTime?        @default(now()) @db.DateTime(0)
  updatedAt        DateTime?        @default(now()) @db.DateTime(0)
  units            Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inventory_items_ibfk_1")
  order_items      OrderItem[]
  consignment_item ConsignmentItem?
  purchase_items   PurchaseItem[]
  stock_batch_items StockBatchItem[]

  @@index([unitId], map: "unitId")
  @@map("inventory_items")
}

model StockBatch {
  id          String           @id @default(cuid()) @db.VarChar(36)
  unitId      String           @db.VarChar(36)
  batchNo     String           @db.VarChar(50)
  date        DateTime         @db.DateTime(0)
  kind        String           @default("CAMPURAN") @db.VarChar(20)
  status      String           @default("APPROVED") @db.VarChar(20)
  totalQty    Int              @default(0)
  totalCost   Decimal          @default(0.00) @db.Decimal(15, 2)
  sourceType  String?          @db.VarChar(20)
  sourceRef   String?          @db.VarChar(36)
  note        String?          @db.Text
  createdById String           @db.VarChar(36)
  reviewedById String?         @db.VarChar(36)
  reviewedAt  DateTime?        @db.DateTime(0)
  reviewNote  String?          @db.Text
  createdAt   DateTime?        @default(now()) @db.DateTime(0)
  units       Unit             @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "stock_batches_ibfk_1")
  creator     User             @relation("batchCreator", fields: [createdById], references: [id], onUpdate: Restrict, map: "stock_batches_ibfk_2")
  reviewer    User?            @relation("batchReviewer", fields: [reviewedById], references: [id], onUpdate: Restrict, map: "stock_batches_ibfk_3")
  items       StockBatchItem[]

  @@unique([unitId, batchNo], map: "stock_batches_unit_batchNo_key")
  @@index([unitId, date], map: "stock_batches_unit_date_idx")
  @@map("stock_batches")
}

model StockBatchItem {
  id              String           @id @default(cuid()) @db.VarChar(36)
  batchId         String           @db.VarChar(36)
  inventoryItemId String           @db.VarChar(36)
  qty             Int              @default(1)
  unitCost        Decimal          @default(0.00) @db.Decimal(15, 2)
  finalUnitCost   Decimal?         @db.Decimal(15, 2)
  lineTotal       Decimal          @default(0.00) @db.Decimal(15, 2)
  ownerId         String?          @db.VarChar(36)
  marginType      String?          @db.VarChar(10)
  marginValue     Decimal?         @db.Decimal(12, 2)
  batch           StockBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "stock_batch_items_ibfk_1")
  inventory_items InventoryItem    @relation(fields: [inventoryItemId], references: [id], onUpdate: Restrict, map: "stock_batch_items_ibfk_2")
  owners          ConsignmentOwner? @relation(fields: [ownerId], references: [id], onUpdate: Restrict, map: "stock_batch_items_ibfk_3")

  @@index([batchId], map: "stock_batch_items_batchId_idx")
  @@index([inventoryItemId], map: "stock_batch_items_itemId_idx")
  @@index([ownerId], map: "stock_batch_items_ownerId_idx")
  @@map("stock_batch_items")
}

model PurchaseItem {
  id            String          @id @default(cuid()) @db.VarChar(36)
  unitId        String          @db.VarChar(36)
  transactionId String          @db.VarChar(36)
  itemId        String?         @db.VarChar(36)
  name          String          @db.VarChar(200)
  qty           Int             @default(1)
  estUnitCost   Decimal         @default(0.00) @db.Decimal(15, 2)
  isNewItem     Boolean?        @default(false)
  fulfilled     Int?            @default(0)
  status        String?         @default("PENDING") @db.VarChar(20)
  note          String?         @db.Text
  createdAt     DateTime?       @default(now()) @db.DateTime(0)
  updatedAt     DateTime?       @default(now()) @db.DateTime(0)
  units         Unit            @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "purchase_items_ibfk_1")
  transactions  Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "purchase_items_ibfk_2")
  inventory_items InventoryItem? @relation(fields: [itemId], references: [id], onUpdate: Restrict, map: "purchase_items_ibfk_3")

  @@index([transactionId], map: "purchase_items_transactionId_idx")
  @@index([itemId], map: "purchase_items_itemId_idx")
  @@index([unitId], map: "purchase_items_unitId_idx")
  @@map("purchase_items")
}

model OrderItem {
  id              String         @id @default(cuid()) @db.VarChar(36)
  transactionId   String         @db.VarChar(36)
  itemId          String?        @db.VarChar(36)
  itemName        String         @db.VarChar(255)
  quantity        Int?           @default(1)
  unitPrice       Decimal        @db.Decimal(12, 2)
  totalPrice      Decimal        @db.Decimal(12, 2)
  transactions    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_items_ibfk_1")
  inventory_items InventoryItem? @relation(fields: [itemId], references: [id], onUpdate: Restrict, map: "order_items_ibfk_2")

  @@index([itemId], map: "itemId")
  @@index([transactionId], map: "transactionId")
  @@map("order_items")
}

model Notification {
  id        String           @id @default(cuid()) @db.VarChar(36)
  userId    String?          @db.VarChar(36)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean?         @default(false)
  createdAt DateTime?        @default(now()) @db.DateTime(0)
  updatedAt DateTime?        @default(now()) @db.DateTime(0)
  users     User?            @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "notifications_ibfk_1")

  @@index([userId], map: "userId")
  @@map("notifications")
}

model BroadcastMessage {
  id                   String               @id @default(cuid()) @db.VarChar(36)
  title                String               @db.VarChar(200)
  message              String               @db.Text
  type                 String?              @default("INFO") @db.VarChar(20)
  priority             String?              @default("NORMAL") @db.VarChar(20)
  status               BroadcastStatus?     @default(DRAFT)
  isDraft              Boolean?             @default(true)
  isSent               Boolean?             @default(false)
  sentAt               DateTime?            @db.DateTime(0)
  deliveredTo          Int?
  lembagaId            String?              @db.VarChar(36)
  senderId             String               @db.VarChar(36)
  createdAt            DateTime?            @default(now()) @db.DateTime(0)
  updatedAt            DateTime?            @default(now()) @db.DateTime(0)
  lembagas             Lembaga?             @relation(fields: [lembagaId], references: [id], onUpdate: Restrict, map: "broadcast_messages_ibfk_1")
  users                User                 @relation(fields: [senderId], references: [id], onUpdate: Restrict, map: "broadcast_messages_ibfk_2")
  broadcast_recipients BroadcastRecipient[]

  @@index([lembagaId], map: "lembagaId")
  @@index([senderId], map: "senderId")
  @@map("broadcast_messages")
}

model BroadcastRecipient {
  id                 String           @id @default(cuid()) @db.VarChar(36)
  broadcastId        String           @db.VarChar(36)
  userId             String           @db.VarChar(36)
  isRead             Boolean?         @default(false)
  createdAt          DateTime?        @default(now()) @db.DateTime(0)
  broadcast_messages BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "broadcast_recipients_ibfk_1")
  users              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "broadcast_recipients_ibfk_2")

  @@index([broadcastId], map: "broadcastId")
  @@index([userId], map: "userId")
  @@map("broadcast_recipients")
}

model UnitSetting {
  id               String    @id @default(cuid()) @db.VarChar(36)
  unitId           String    @unique(map: "unitId") @db.VarChar(36)
  posEnabled       Boolean?  @default(true)
  inventoryEnabled Boolean?  @default(true)
  autoApproval     Boolean?  @default(false)
  requiresApproval Boolean?  @default(true)
  createdAt        DateTime? @default(now()) @db.DateTime(0)
  updatedAt        DateTime? @default(now()) @db.DateTime(0)

  @@map("unit_settings")
}

model SystemSetting {
  id          String    @id @default(cuid()) @db.VarChar(36)
  key         String    @unique(map: "key") @db.VarChar(255)
  value       String?   @db.Text
  description String?   @db.Text
  createdAt   DateTime? @default(now()) @db.DateTime(0)
  updatedAt   DateTime? @default(now()) @updatedAt @db.DateTime(0)

  @@map("system_settings")
}

model audit_logs {
  id        String    @id @db.VarChar(36)
  userId    String?   @db.VarChar(36)
  action    String    @db.VarChar(255)
  entity    String    @db.VarChar(100)
  entityId  String?   @db.VarChar(36)
  oldData   String?   @db.Text
  newData   String?   @db.Text
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(500)
  createdAt DateTime? @default(now()) @db.DateTime(0)
  users     User?     @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "audit_logs_ibfk_1")

  @@index([userId], map: "userId")
}

model push_subscriptions {
  id        String    @id @db.VarChar(36)
  userId    String    @db.VarChar(36)
  endpoint  String    @unique(map: "endpoint") @db.VarChar(512)
  keys      String    @db.LongText
  expiresAt DateTime? @db.DateTime(0)
  createdAt DateTime? @default(now()) @db.DateTime(0)
  updatedAt DateTime? @default(now()) @db.DateTime(0)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "push_subscriptions_ibfk_1")

  @@index([userId], map: "userId")
}

