generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lembaga {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       Unit[]
  users       User[]
  broadcastMessages BroadcastMessage[]

  @@map("lembarga")
}

model Unit {
  id           String        @id @default(cuid())
  name         String        @unique
  code         String        @unique
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lembagaId    String?       @map("lembaga_id")
  isRetail     Boolean       @default(false) @map("is_retail")
  parentId     String?       @map("parent_id")
  parent       Unit?         @relation("UnitParent", fields: [parentId], references: [id])
  children     Unit[]        @relation("UnitParent")
  transactions Transaction[]
  unitSetting  UnitSetting?
  inventoryItems InventoryItem[]
  lembaga      Lembaga?      @relation(fields: [lembagaId], references: [id])
  users        User[]

  @@index([lembagaId], map: "units_lembaga_id_fkey")
  @@index([parentId], map: "units_parent_id_fkey")
  @@map("units")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  name                 String?
  passwordHash         String             @map("password_hash")
  role                 Role               @default(STAFF)
  unitId               String?            @map("unit_id")
  lembagaId            String?            @map("lembaga_id")
  isActive             Boolean            @default(true)
  emailVerified        DateTime?          @map("email_verified")
  image                String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  approvals            Approval[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  transactionsApproved Transaction[]      @relation("TransactionApprover")
  transactionsCreated  Transaction[]      @relation("TransactionCreator")
  unit                 Unit?              @relation(fields: [unitId], references: [id])
  lembaga              Lembaga?           @relation(fields: [lembagaId], references: [id])
  sentBroadcasts       BroadcastMessage[] @relation("SentBroadcasts")
  receivedBroadcasts   BroadcastRecipient[] @relation("ReceivedBroadcasts")

  @@index([unitId], map: "users_unit_id_fkey")
  @@index([lembagaId], map: "users_lembaga_id_fkey")
  @@map("users")
}

model Transaction {
  id           String            @id @default(cuid())
  unitId       String            @map("unit_id")
  type         TransactionType
  amount       Float
  description  String
  status       TransactionStatus @default(DRAFT)
  reference    String?
  createdById  String            @map("created_by_id")
  approvedById String?           @map("approved_by_id")
  approvedAt   DateTime?         @map("approved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  accountId    String?           @map("account_id")
  photoUrl     String?           @map("photo_url")
  approvals    Approval[]
  orderItems   OrderItem[]
  account      Account?          @relation(fields: [accountId], references: [id])
  approvedBy   User?             @relation("TransactionApprover", fields: [approvedById], references: [id])
  createdBy    User              @relation("TransactionCreator", fields: [createdById], references: [id])
  unit         Unit              @relation(fields: [unitId], references: [id])

  @@index([unitId])
  @@index([status])
  @@index([createdById])
  @@index([accountId], map: "transactions_account_id_fkey")
  @@index([approvedById], map: "transactions_approved_by_id_fkey")
  @@index([status, createdAt])
  @@index([unitId, createdAt])
  @@index([type, createdAt])
  @@map("transactions")
}

model OrderItem {
  id             String        @id @default(cuid())
  transactionId  String        @map("transaction_id")
  itemId         String?       @map("item_id")
  itemName       String
  quantity       Int           @default(1)
  unitPrice      Decimal       @db.Decimal(12,2)
  totalPrice     Decimal       @db.Decimal(12,2)
  inventoryItem  InventoryItem? @relation(fields: [itemId], references: [id])
  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([itemId])
  @@map("order_items")
}

model Approval {
  id            String         @id @default(cuid())
  transactionId String         @map("transaction_id")
  approverId    String         @map("approver_id")
  status        ApprovalStatus @default(PENDING)
  comment       String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  approver      User           @relation(fields: [approverId], references: [id])
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([approverId])
  @@map("approvals")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   String?  @map("old_data")
  newData   String?  @map("new_data")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Account {
  id           String        @id @default(cuid())
  name         String        @unique
  code         String        @unique
  type         AccountType
  description  String?
  parentId     String?       @map("parent_id")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  parent       Account?      @relation("AccountParent", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountParent")
  transactions Transaction[]

  @@index([type])
  @@index([parentId])
  @@map("accounts")
}

model Notification {
  id        String             @id @default(cuid())
  userId    String?            @map("user_id")
  title     String
  message   String
  type      notifications_type
  isRead    Boolean            @default(false) @map("is_read")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User?              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  endpoint  String    @unique @map("endpoint") @db.VarChar(512)
  keys      String    @db.LongText
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@map("account_type")
}

enum Role {
  SUPERADMIN
  PIMPINAN
  MANAGER
  STAFF

  @@map("role")
}

enum TransactionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@map("transaction_status")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

enum BroadcastStatus {
  DRAFT
  PENDING
  SENT
  FAILED

  @@map("broadcast_status")
}

model UnitSetting {
  id            String   @id @default(cuid())
  unitId        String   @unique @map("unit_id")
  posEnabled    Boolean  @default(true) @map("pos_enabled")
  inventoryEnabled Boolean @default(true) @map("inventory_enabled")
  autoApproval  Boolean  @default(false) @map("auto_approval")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @map("updated_at")
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_settings")
}

model InventoryItem {
  id            String        @id @default(cuid())
  unitId        String        @map("unit_id")
  name          String        @db.VarChar(200)
  sku           String        @unique @db.VarChar(50)
  currentStock  Int           @default(0) @map("current_stock")
  minStock      Int           @default(0) @map("min_stock")
  unitPrice     Decimal?      @db.Decimal(12,2) @map("unit_price")
  category      String?       @db.VarChar(100)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt @map("updated_at")
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([unitId])
  @@index([category])
  @@map("inventory_items")
}

model BroadcastMessage {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(200)
  message       String   @db.Text
  type          String   @default("INFO") @db.VarChar(20)
  priority      String   @default("NORMAL") @db.VarChar(20)
  status        BroadcastStatus @default(DRAFT)
  isDraft       Boolean  @default(true)
  isSent        Boolean  @default(false)
  sentAt        DateTime? @map("sent_at")
  deliveredTo   Int?     @map("delivered_to")
  lembagaId     String?  @map("lembaga_id")
  senderId      String   @map("sender_id")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @map("updated_at")
  sender        User     @relation("SentBroadcasts", fields: [senderId], references: [id])
  recipients    BroadcastRecipient[]
  lembaga       Lembaga? @relation(fields: [lembagaId], references: [id])

  @@index([senderId])
  @@index([lembagaId])
  @@map("broadcast_messages")
}

model BroadcastRecipient {
  id            String   @id @default(cuid())
  broadcastId   String   @map("broadcast_id")
  userId        String   @map("user_id")
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now())
  broadcast     BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user          User     @relation("ReceivedBroadcasts", fields: [userId], references: [id])

  @@index([broadcastId])
  @@index([userId])
  @@unique([broadcastId, userId])
  @@map("broadcast_recipients")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum notifications_type {
  INFO
  SUCCESS
  WARNING
  ERROR
}