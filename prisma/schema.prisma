model ShiftAttendance {
  id         String    @id @default(cuid()) @db.VarChar(36)
  unitId     String    @db.VarChar(36)
  userId     String    @db.VarChar(36)
  date       DateTime  @db.DateTime(0)
  checkInAt  DateTime  @db.DateTime(0)
  checkOutAt DateTime? @db.DateTime(0)
  late       Boolean   @default(false)
  service    String?   @db.VarChar(20)
  note       String?   @db.Text
  createdAt  DateTime? @default(now()) @db.DateTime(0)
  units      Unit      @relation(fields: [unitId], references: [id], onUpdate: Restrict)
  user       User      @relation("shiftAttendanceUser", fields: [userId], references: [id], onUpdate: Restrict)

  @@unique([unitId, userId, date], map: "shift_attendance_unit_user_date_key")
  @@index([unitId], map: "shift_attendance_unitId")
  @@index([userId], map: "shift_attendance_userId")
  @@map("shift_attendances")
}

model ShiftReport {
  id                 String            @id @default(cuid()) @db.VarChar(36)
  unitId             String            @db.VarChar(36)
  userId             String            @db.VarChar(36)
  date               DateTime          @db.DateTime(0)
  cashIncomeCounted  Decimal           @db.Decimal(15, 2)
  cashExpenseCounted Decimal           @db.Decimal(15, 2)
  note               String?           @db.Text
  status             ShiftReportStatus @default(SUBMITTED)
  submittedAt        DateTime          @default(now()) @db.DateTime(0)
  reviewedById       String?           @db.VarChar(36)
  reviewedAt         DateTime?         @db.DateTime(0)
  units              Unit              @relation(fields: [unitId], references: [id], onUpdate: Restrict)
  staff              User              @relation("shiftReportStaff", fields: [userId], references: [id], onUpdate: Restrict)
  reviewer           User?             @relation("shiftReportReviewer", fields: [reviewedById], references: [id], onUpdate: Restrict)

  @@unique([unitId, userId, date], map: "shift_reports_unit_user_date_key")
  @@index([unitId], map: "shift_reports_unitId")
  @@index([status], map: "shift_reports_status")
  @@map("shift_reports")
}

model ShiftSession {
  id         String    @id @default(cuid()) @db.VarChar(36)
  unitId     String    @db.VarChar(36)
  userId     String    @db.VarChar(36)
  date       DateTime  @db.DateTime(0)
  checkInAt  DateTime  @db.DateTime(0)
  checkOutAt DateTime? @db.DateTime(0)
  service    String?   @db.VarChar(20)
  note       String?   @db.Text
  createdAt  DateTime? @default(now()) @db.DateTime(0)
  units      Unit      @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "shift_sessions_ibfk_1")
  user       User      @relation("shiftSessionUser", fields: [userId], references: [id], onUpdate: Restrict, map: "shift_sessions_ibfk_2")

  @@index([unitId, userId, date], map: "shift_sessions_unit_user_date_idx")
  @@index([unitId, userId, checkOutAt], map: "shift_sessions_open_idx")
  @@map("shift_sessions")
}

model PosSession {
  id           String       @id @default(cuid()) @db.VarChar(36)
  unitId       String       @db.VarChar(36)
  userId       String       @db.VarChar(36)
  date         DateTime     @db.DateTime(0)
  openedAt     DateTime     @db.DateTime(0)
  openingCash  Decimal      @db.Decimal(15, 2)
  closedAt     DateTime?    @db.DateTime(0)
  expectedCash Decimal?     @db.Decimal(15, 2)
  countedCash  Decimal?     @db.Decimal(15, 2)
  discrepancy  Decimal?     @db.Decimal(15, 2)
  closeNote    String?      @db.Text
  autoClosed   Boolean      @default(false)
  createdAt    DateTime?    @default(now()) @db.DateTime(0)
  units        Unit         @relation(fields: [unitId], references: [id], onUpdate: Restrict, map: "pos_sessions_ibfk_1")
  user         User         @relation("posSessionUser", fields: [userId], references: [id], onUpdate: Restrict, map: "pos_sessions_ibfk_2")
  transactions Transaction[]

  @@index([unitId, userId, date], map: "pos_sessions_unit_user_date_idx")
  @@index([unitId, userId, closedAt], map: "pos_sessions_open_idx")
  @@map("pos_sessions")
}

model BudgetAllocation {
  id          String            @id @default(cuid()) @db.VarChar(36)
  unitId      String            @db.VarChar(36)
  categoryId  String            @db.VarChar(36)
  periodType  String            @default("MONTHLY") @db.VarChar(10)
  period      String            @db.VarChar(32)
  title       String?           @db.VarChar(255)
  startDate   DateTime?         @db.DateTime(0)
  endDate     DateTime?         @db.DateTime(0)
  amount      Decimal           @db.Decimal(15, 2)
  note        String?           @db.Text
  // Sumber dana alokasi: KPAK (kas unit) atau LEMBAGA (kas lembaga). Dipilih pimpinan saat budgeting.
  source      String?           @default("KPAK") @db.VarChar(16)
  isActive    Boolean?          @default(true)
  createdById String            @db.VarChar(36)
  createdAt   DateTime?         @default(now()) @db.DateTime(0)
  units       Unit              @relation(fields: [unitId], references: [id], onUpdate: Restrict)
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onUpdate: Restrict)
  creator     User              @relation("allocationCreator", fields: [createdById], references: [id], onUpdate: Restrict)

  @@unique([unitId, categoryId, period], map: "budget_allocations_unit_cat_period_key")
  @@index([unitId], map: "budget_allocations_unitId")
  @@map("budget_allocations")
}

enum ShiftReportStatus {
  SUBMITTED
  ACCEPTED

  @@map("shift_report_status")
}

model ConsignmentOwner {
  id        String              @id @default(cuid()) @db.VarChar(36)
  unitId    String              @db.VarChar(36)
  name      String              @db.VarChar(255)
  phone     String?             @db.VarChar(50)
  whatsappVerified Boolean       @default(false)
  address   String?             @db.Text
  isActive  Boolean?            @default(true)
  createdAt DateTime?           @default(now()) @db.DateTime(0)
  updatedAt DateTime?           @default(now()) @db.DateTime(0)
  units     Unit                @relation(fields: [unitId], references: [id], onUpdate: Restrict)
  items     ConsignmentItem[]
  payouts   ConsignmentPayout[]
  stock_batch_items StockBatchItem[]

  @@index([unitId], map: "consignment_owners_unitId")
  @@map("consignment_owners")
}

model ConsignmentItem {
  id              String           @id @default(cuid()) @db.VarChar(36)
  unitId          String           @db.VarChar(36)
  ownerId         String           @db.VarChar(36)
  inventoryItemId String           @unique(map: "consignment_items_inventoryItemId_key") @db.VarChar(36)
  marginType      MarginType       @default(PERCENT)
  marginValue     Decimal          @default(0.00) @db.Decimal(12, 2)
  costPrice       Decimal          @db.Decimal(12, 2)
  agreedPrice     Decimal          @db.Decimal(12, 2)
  isActive        Boolean?         @default(true)
  createdAt       DateTime?        @default(now()) @db.DateTime(0)
  updatedAt       DateTime?        @default(now()) @db.DateTime(0)
  units           Unit             @relation(fields: [unitId], references: [id], onUpdate: Restrict)
  owners          ConsignmentOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  inventoryItems  InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([unitId], map: "consignment_items_unitId")
  @@index([ownerId], map: "consignment_items_ownerId")
  @@map("consignment_items")
}

model ConsignmentPayout {
  id            String           @id @default(cuid()) @db.VarChar(36)
  unitId        String           @db.VarChar(36)
  ownerId       String           @db.VarChar(36)
  amount        Decimal          @db.Decimal(15, 2)
  fromDate      DateTime         @db.DateTime(0)
  toDate        DateTime         @db.DateTime(0)
  status        PayoutStatus     @default(PENDING)
  transactionId String?          @db.VarChar(36)
  paidById      String?          @db.VarChar(36)
  note          String?          @db.Text
  createdAt     DateTime?        @default(now()) @db.DateTime(0)
  updatedAt     DateTime?        @default(now()) @db.DateTime(0)
  units         Unit             @relation(fields: [unitId], references: [id], onUpdate: Restrict)
  owners        ConsignmentOwner @relation(fields: [ownerId], references: [id], onUpdate: Restrict)
  transactions  Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  paidBy        User?            @relation("consignmentPayoutPaidBy", fields: [paidById], references: [id], onUpdate: Restrict)

  @@index([unitId], map: "consignment_payouts_unitId")
  @@index([ownerId], map: "consignment_payouts_ownerId")
  @@index([status], map: "consignment_payouts_status")
  @@map("consignment_payouts")
}

enum MarginType {
  PERCENT
  FIXED

  @@map("margin_type")
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED

  @@map("payout_status")
}
