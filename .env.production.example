# ============================================================
# ALBA Finance v7 — Template Environment Produksi (Hostinger)
# ============================================================
# Environment produksi di-set di hPanel (Node.js → Environment Variables),
# BUKAN lewat file ini. File ini hanya referensi daftar variabel.
# JANGAN commit file .env.production apa pun ke Git!

# --- Database MySQL Hostinger ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# Gunakan "localhost" sebagai HOST di Hostinger (bukan 127.0.0.1)
DATABASE_URL="mysql://u826712707_alba:yourpassword@localhost:3306/u826712707_alba"

# --- NextAuth ---
# URL publik aplikasi (tanpa trailing slash)
NEXTAUTH_URL="https://alba.brontolano.com"

# Secret JWT — WAJIB diisi string acak 32+ karakter
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti_dengan_output_dari_openssl_rand_-base64_32"

# Kredensial akun login produksi (default seed)
NEXTAUTH_EMAIL="admin@alba.id"
NEXTAUTH_PASSWORD="admin123"

# --- Runtime ---
NODE_ENV="production"

# --- Backup (opsional) ---
BACKUP_DIRECTORY="/path/ke/folder/backup"
BACKUP_RETENTION_DAYS="14"
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"
GOOGLE_APPS_SCRIPT_SECRET="shared-secret-yang-sama"
# Bukti transaksi ke Google Drive (lihat scripts/google-drive-upload.gs).
# Tanpa ini, bukti tersimpan lokal sementara (peringatan di aplikasi).
GOOGLE_DRIVE_ROOT_FOLDER_ID="1TU-sagmevhdzy-dn7FlSs9uktnftJ3nj"