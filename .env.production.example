# ============================================================
# ALBA Finance v3 — Template Environment Produksi (Hostinger)
# ============================================================
# Salin file ini ke .env.production dan isi dengan nilai yang sesuai
# JANGAN commit .env.production ke Git!

# --- Database MySQL Hostinger ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="mysql://u123456789_alba:yourpassword@localhost:3306/u123456789_alba"

# --- NextAuth ---
# URL publik aplikasi Anda (tanpa trailing slash)
NEXTAUTH_URL="https://alba.brontolano.com"

# Secret untuk JWT — WAJIB diisi dengan string acak 32+ karakter
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti_dengan_output_dari_openssl_rand_-base64_32"

# --- Runtime ---
NODE_ENV="production"

# Port yang digunakan Hostinger (biasanya diset otomatis oleh hPanel)
# PORT=3000
# HOSTNAME=0.0.0.0

# --- App Info (opsional, sudah ada di kode) ---
NEXT_PUBLIC_APP_NAME="ALBA Finance v3"
